<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base dark theme (Spotilol is dark-only, like the original). -->
    <style name="Theme.Spotilol" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryDark">@color/spotify_green_dark</item>
        <item name="colorAccent">@color/spotify_green</item>
        <item name="android:colorBackground">@color/dark_surface</item>
        <item name="android:windowBackground">@color/dark_surface</item>
        <item name="android:statusBarColor">@color/dark_surface</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- AMOLED variant: pure black everywhere. Applied at runtime when enabled. -->
    <style name="Theme.Spotilol.Amoled" parent="Theme.Spotilol">
        <item name="android:colorBackground">@color/amoled_black</item>
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:statusBarColor">@color/amoled_black</item>
        <item name="android:navigationBarColor">@color/amoled_black</item>
    </style>

    <style name="Theme.Spotilol.Settings" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorAccent">@color/spotify_green</item>
    </style>
</resources>
